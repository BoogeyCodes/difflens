{
  "name": "difflens",
  "version": "0.1.0",
  "description": "Build side-by-side, multi-run diff views for comparing what several AI coding-agent runs changed.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["diff", "side-by-side", "ai-agents", "llm-evaluation", "code-review", "typescript"],
  "author": "Abdul Raheem",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/BoogeyCodes/difflens.git" },
  "homepage": "https://github.com/BoogeyCodes/difflens#readme",
  "bugs": { "url": "https://github.com/BoogeyCodes/difflens/issues" },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
